# wave-A3 S0 — local-dev TLS termination via Caddy's bundled
# self-signed CA (`tls internal`). Operator imports the CA cert
# from the `caddy-data` volume on first run; the runbook
# documents the exact command.
#
# Why bother with TLS in dev:
#   - exercises the cookie `Secure` flag end-to-end before prod
#   - exercises the X-Forwarded-* plumbing the rate limiter (S1)
#     keys on
#   - lets Playwright e2e prove the prod-shaped flow without
#     touching Let's Encrypt
#
# S0-audit M2 fix: the site address MUST be a concrete hostname
# (`localhost` here) — Caddy's internal CA needs an SNI value to
# put in the SAN. A bare `:443` block accepted connections but
# served no cert, so `curl -kI https://localhost/` failed on the
# TLS handshake. `localhost` covers both browser-side dev + the
# 127.0.0.1 loop curl uses by default.

import /etc/caddy/snippets/headers.caddy

{
	# Admin endpoint is bound to the container only; the host
	# never sees :2019.
	admin off
	auto_https disable_redirects
}

# HTTP → HTTPS redirect on :80 so `curl http://localhost/` matches
# prod behaviour.
http://localhost {
	redir https://localhost{uri} permanent
}

# `tls internal` issues a self-signed cert for the configured
# hostnames. Listing both `localhost` and `127.0.0.1` so the
# cert's SAN covers either form of address curl / a browser might
# resolve.
https://localhost, https://127.0.0.1 {
	tls internal

	import security-headers

	encode zstd gzip

	reverse_proxy consigliere:5000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
		header_up X-Real-IP {remote_host}
	}
}
